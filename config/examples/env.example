# OpenShift Configuration
OPENSHIFT_TOKEN=your_openshift_token_here
OPENSHIFT_URL=https://your-cluster.openshift.com:6443
OPENSHIFT_TIMEOUT=30

# LLM Provider Configuration
# Choose your provider type: openai, azure_openai, custom_openai, anthropic, google, custom
LLM_PROVIDER_TYPE=openai

# OpenAI Configuration (default)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT=30
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# Complete OpenAI API URL (for organizational proxy or custom endpoints)
# You can specify the URL up to /chat/completions - it will be automatically processed
# LLM_BASE_URL=https://openai-proxy.your-company.com/v1/chat/completions
# LLM_BASE_URL=https://openai-proxy.your-company.com/v1

# Azure OpenAI Configuration (when LLM_PROVIDER_TYPE=azure_openai)
# LLM_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/chat/completions
# LLM_BASE_URL=https://your-resource.openai.azure.com/openai/deployments
# LLM_API_VERSION=2024-02-15-preview
# LLM_DEPLOYMENT_NAME=your-deployment-name

# Custom Headers (optional, for authentication or custom requirements)
# Format: JSON string with header key-value pairs
# LLM_ADDITIONAL_HEADERS={"X-Custom-Header": "value", "Authorization": "Bearer token"}

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_SIZE=1000
CACHE_ENABLE_STALE=true

# Server Configuration
SERVER_TIMEOUT=30
SERVER_HOST=localhost
SERVER_PORT=8000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Background Task Configuration
BACKGROUND_TASK_TIMEOUT=60
BACKGROUND_TASK_MAX_CONCURRENT=10

# Performance Configuration
QUERY_TIMEOUT=5
ENABLE_BACKGROUND_REFRESH=true 